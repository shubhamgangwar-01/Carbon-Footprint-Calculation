# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://localhost:5432/conference_carbon
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=choose-a-strong-password
CORS_ORIGINS=http://localhost:5173
# Optional road/rail distance estimation via OpenStreetMap Nominatim + OSRM (respect their usage policies)
ENABLE_ONLINE_GEOCODING=false
GEOCODER_USER_AGENT=ConferenceCarbonCalculator/1.0 (contact: your-email@example.org)
AUTO_MIGRATE=true
# frontend build-time (only when the API is on a different origin, e.g. Vercel + Render)
VITE_API_URL=
